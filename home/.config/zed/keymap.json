[
  {
    "context": "Workspace",
    "bindings": {
      "shift-cmd-n": "workspace::NewTerminal",
      "shift-cmd-i": "agent::ToggleFocus",
      "ctrl-shift-h": "workspace::ToggleLeftDock",
      "ctrl-shift-j": "workspace::ToggleBottomDock",
      "ctrl-shift-k": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-shift-l": "workspace::ToggleRightDock",
      "ctrl-shift-f": "workspace::ToggleAllDocks"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "k j": "vim::NormalBefore"
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "k j": ["vim::SwitchMode", "Normal"]
    }
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "space space": "file_finder::Toggle"
    }
  },
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "space space": "file_finder::Toggle",
      "ctrl-h": "agent::ToggleFocus",
      "ctrl-j": "terminal_panel::ToggleFocus",
      "ctrl-l": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-h": "agent::ToggleFocus",
      "ctrl-j": "terminal_panel::ToggleFocus",
      "ctrl-l": "project_panel::ToggleFocus",
      "ctrl-[": "pane::ActivatePreviousItem",
      "ctrl-]": "pane::ActivateNextItem",
      "ctrl-shift-f": "workspace::ToggleAllDocks"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "x": "project_panel::Cut",
      "d": ["project_panel::Delete", { "skip_prompt": true }],
      "s": "project_panel::OpenSplitVertical",
      "shift-s": "project_panel::OpenSplitHorizontal",
      "enter": "project_panel::OpenPermanent",
      "ctrl-h": "project_panel::ToggleFocus",
      "ctrl-j": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-w": "pane::CloseActiveItem",
      "ctrl-h": "agent::ToggleFocus",
      "ctrl-k": "terminal_panel::ToggleFocus",
      "ctrl-l": "project_panel::ToggleFocus",
      "ctrl-[": "pane::ActivatePreviousItem",
      "ctrl-]": "pane::ActivateNextItem"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-h": "multi_workspace::FocusWorkspaceSidebar",
      "ctrl-l": "agent::ToggleFocus",
      "ctrl-[": "multi_workspace::PreviousThread",
      "ctrl-]": "multi_workspace::NextThread"
    }
  },
  {
    "context": "AgentPanel > Editor",
    "bindings": {
      "ctrl-h": "multi_workspace::FocusWorkspaceSidebar",
      "ctrl-l": "agent::ToggleFocus",
      "ctrl-[": "multi_workspace::PreviousThread",
      "ctrl-]": "multi_workspace::NextThread"
    }
  },
  {
    "context": "AgentPanel > Terminal",
    "bindings": {
      "ctrl-w": ["terminal::SendKeystroke", "ctrl-w"],
      "ctrl-k": ["terminal::SendKeystroke", "ctrl-k"],
      "ctrl-h": "multi_workspace::FocusWorkspaceSidebar",
      "ctrl-l": "agent::ToggleFocus",
      "ctrl-[": "multi_workspace::PreviousThread",
      "ctrl-]": "multi_workspace::NextThread"
    }
  },
  {
    "context": "ThreadsSidebar",
    "bindings": {
      "ctrl-h": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-l": "multi_workspace::FocusWorkspaceSidebar",
      "ctrl-shift-k": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-[": "multi_workspace::PreviousThread",
      "ctrl-]": "multi_workspace::NextThread"
    }
  },
  {
    "context": "ThreadsSidebar > Editor",
    "bindings": {
      "ctrl-h": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-l": "multi_workspace::FocusWorkspaceSidebar",
      "ctrl-shift-k": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-[": "multi_workspace::PreviousThread",
      "ctrl-]": "multi_workspace::NextThread"
    }
  },
  {
    "context": "ThreadsSidebar && searching > Editor && vim_mode == normal",
    "bindings": {
      "t": "agent::NewTerminalThread",
      "a": "agents_sidebar::NewThreadInGroup"
    }
  },
  {
    "context": "ThreadsSidebar && not_searching",
    "bindings": {
      "t": "agent::NewTerminalThread",
      "a": "agents_sidebar::NewThreadInGroup",
      "r": "agent::RenameSelectedThread",
      "d": "agent::ArchiveSelectedThread"
    }
  }
]

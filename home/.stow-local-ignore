# A package-local list replaces Stow's built-in defaults, none of which occur
# in this package. Finder metadata is not a Stow default, so it is listed here.
\.DS_Store

# Machine-local or generated paths that must never be deployed.
^/\.config/yazi/flavors($|/)
# Only the shared Codex instructions belong in the Stow package.
^/\.codex/(?!AGENTS\.md$).+

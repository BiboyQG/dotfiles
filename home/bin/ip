#!/usr/bin/env bash
set -euo pipefail

endpoints=(
  "https://api.ipify.org"
  "https://ipv4.icanhazip.com"
  "https://checkip.amazonaws.com"
)

valid_ipv4() {
  local ip="$1" octet
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  for octet in ${ip//./ }; do
    (( 10#$octet <= 255 )) || return 1
  done
}

for url in "${endpoints[@]}"; do
  if raw="$(curl -4 -fsSL --max-time 2 "$url" 2>/dev/null)"; then
    ip="$(printf '%s' "$raw" | tr -d ' \t\r\n')"
    if valid_ipv4 "$ip"; then
      printf '%s\n' "$ip"
      exit 0
    fi
  fi
done

printf 'unable to determine public IPv4\n' >&2
exit 1

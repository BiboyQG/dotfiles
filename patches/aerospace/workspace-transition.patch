diff --git a/Sources/AppBundleTests/WorkspaceTransitionTest.swift b/Sources/AppBundleTests/WorkspaceTransitionTest.swift
new file mode 100644
index 0000000..e6897c1
--- /dev/null
+++ b/Sources/AppBundleTests/WorkspaceTransitionTest.swift
@@ -0,0 +1,225 @@
+@testable import AppBundle
+import Common
+import Foundation
+import XCTest
+
+@MainActor
+final class WorkspaceTransitionTest: XCTestCase {
+    func testRestoresEveryForegroundAppBeforeHidingOutgoingWindows() async throws {
+        let slowApp = TestAppRunLoop()
+        let fastApp = TestAppRunLoop()
+        defer {
+            slowApp.stop()
+            fastApp.stop()
+        }
+        let releaseSlowFrame = DispatchSemaphore(value: 0)
+        defer { releaseSlowFrame.signal() }
+        let slowFrameStarted = XCTestExpectation(description: "slow frame started")
+        let slowFrameFinished = DispatchSemaphore(value: 0)
+        let fastFrameFinished = DispatchSemaphore(value: 0)
+        let slowFrame = slowApp.enqueue {
+            slowFrameStarted.fulfill()
+            assertEquals(releaseSlowFrame.wait(timeout: .now() + 5), .success)
+            slowFrameFinished.signal()
+        }
+        let fastFrame = fastApp.enqueue { fastFrameFinished.signal() }
+        await waitFor(slowFrameStarted)
+        try await fastFrame.awaitCompletion()
+
+        let generation = LayoutGeneration()
+        let pass = generation.begin()
+        let transitionStarted = XCTestExpectation(description: "transition started")
+        var didHide = false
+        let transition = Task<Bool, any Error> { @MainActor in
+            transitionStarted.fulfill()
+            return try await pass.afterRestoring([slowFrame, fastFrame]) {
+                assertTrue(hasCompleted(slowFrameFinished))
+                assertTrue(hasCompleted(fastFrameFinished))
+                didHide = true
+            }
+        }
+        await waitFor(transitionStarted)
+        assertFalse(didHide)
+        releaseSlowFrame.signal()
+        assertTrue(try await transition.value)
+        assertTrue(didHide)
+    }
+
+    func testNewerWorkspaceTransitionRejectsPendingOldHide() async throws {
+        let app = TestAppRunLoop()
+        defer { app.stop() }
+        let releaseFrame = DispatchSemaphore(value: 0)
+        defer { releaseFrame.signal() }
+        let frameStarted = XCTestExpectation(description: "frame started")
+        let frame = app.enqueue {
+            frameStarted.fulfill()
+            assertEquals(releaseFrame.wait(timeout: .now() + 5), .success)
+        }
+        await waitFor(frameStarted)
+
+        var hiddenBy: [String] = []
+        let generation = LayoutGeneration()
+        let oldPass = generation.begin()
+        let oldTransitionStarted = XCTestExpectation(description: "old transition started")
+        let oldTransition = Task<Bool, any Error> { @MainActor in
+            oldTransitionStarted.fulfill()
+            return try await oldPass.afterRestoring([frame]) { hiddenBy.append("B") }
+        }
+        await waitFor(oldTransitionStarted)
+        let newPass = generation.begin()
+        assertTrue(try await newPass.afterRestoring([]) { hiddenBy.append("C") })
+        releaseFrame.signal()
+
+        assertFalse(try await oldTransition.value)
+        assertEquals(hiddenBy, ["C"])
+        assertTrue(newPass.isCurrent)
+    }
+
+    func testLogicalWorkspaceChangeRejectsHideBeforeAnotherLayoutBegins() async throws {
+        let app = TestAppRunLoop()
+        defer { app.stop() }
+        let releaseFrame = DispatchSemaphore(value: 0)
+        defer { releaseFrame.signal() }
+        let frameStarted = XCTestExpectation(description: "frame started")
+        let frame = app.enqueue {
+            frameStarted.fulfill()
+            assertEquals(releaseFrame.wait(timeout: .now() + 5), .success)
+        }
+        await waitFor(frameStarted)
+
+        let activeWorkspace = TestWorkspaceSelection("B")
+        let generation = LayoutGeneration()
+        let pass = generation.begin(isValid: { activeWorkspace.name == "B" })
+        let transitionStarted = XCTestExpectation(description: "transition started")
+        var didHide = false
+        let transition = Task<Bool, any Error> { @MainActor in
+            transitionStarted.fulfill()
+            return try await pass.afterRestoring([frame]) { didHide = true }
+        }
+        await waitFor(transitionStarted)
+        activeWorkspace.name = "C"
+        releaseFrame.signal()
+
+        assertFalse(try await transition.value)
+        assertFalse(didHide)
+    }
+
+    func testNewTransitionDuringSuspendedHideInvalidatesOldResult() async throws {
+        let allowHideToReturn = AwaitableOneTimeBroadcastLatch()
+        let hideStarted = XCTestExpectation(description: "hide started")
+        let generation = LayoutGeneration()
+        let oldPass = generation.begin()
+        let oldTransition = Task<Bool, any Error> { @MainActor in
+            try await oldPass.afterRestoring([]) {
+                hideStarted.fulfill()
+                try await allowHideToReturn.await()
+            }
+        }
+        await waitFor(hideStarted)
+        let newPass = generation.begin()
+        await allowHideToReturn.signalToAll()
+
+        assertFalse(try await oldTransition.value)
+        assertTrue(newPass.isCurrent)
+    }
+
+    func testCancellingRestoreWaitReturnsWhileApplicationIsStillBlocked() async throws {
+        let app = TestAppRunLoop()
+        defer { app.stop() }
+        let releaseFrame = DispatchSemaphore(value: 0)
+        defer { releaseFrame.signal() }
+        let frameStarted = XCTestExpectation(description: "frame started")
+        let frameFinished = DispatchSemaphore(value: 0)
+        let frame = app.enqueue {
+            frameStarted.fulfill()
+            _ = releaseFrame.wait(timeout: .now() + 5)
+            frameFinished.signal()
+        }
+        await waitFor(frameStarted)
+
+        let generation = LayoutGeneration()
+        let pass = generation.begin()
+        let transitionStarted = XCTestExpectation(description: "transition started")
+        var didHide = false
+        let transition = Task<Bool, any Error> { @MainActor in
+            transitionStarted.fulfill()
+            return try await pass.afterRestoring([frame]) { didHide = true }
+        }
+        await waitFor(transitionStarted)
+        transition.cancel()
+        do {
+            _ = try await transition.value
+            XCTFail("Expected CancellationError")
+        } catch is CancellationError {
+            // Cancellation must not wait for the blocked application to respond.
+        }
+        assertFalse(hasCompleted(frameFinished))
+        assertFalse(didHide)
+        releaseFrame.signal()
+        try await frame.awaitCompletion()
+    }
+
+    func testAppShutdownDrainsCancelledFrameAndReleasesCompletionWaiters() async throws {
+        let app = TestAppRunLoop()
+        defer { app.stop() }
+        let releaseBlocker = DispatchSemaphore(value: 0)
+        defer { releaseBlocker.signal() }
+        let blockerStarted = XCTestExpectation(description: "blocker started")
+        _ = app.enqueue {
+            blockerStarted.fulfill()
+            assertEquals(releaseBlocker.wait(timeout: .now() + 5), .success)
+        }
+        await waitFor(blockerStarted)
+        let frameDidRun = DispatchSemaphore(value: 0)
+        let frame = app.enqueue { frameDidRun.signal() }
+        frame.cancel()
+        app.stop()
+        releaseBlocker.signal()
+
+        try await frame.awaitCompletion()
+        assertFalse(hasCompleted(frameDidRun))
+    }
+
+    private func waitFor(_ expectation: XCTestExpectation) async {
+        assertEquals(await XCTWaiter.fulfillment(of: [expectation], timeout: 5), .completed)
+    }
+}
+
+private func hasCompleted(_ semaphore: DispatchSemaphore) -> Bool {
+    semaphore.wait(timeout: .now()) == .success
+}
+
+@MainActor
+private final class TestWorkspaceSelection {
+    var name: String
+
+    init(_ name: String) {
+        self.name = name
+    }
+}
+
+@MainActor
+private final class TestAppRunLoop {
+    private let thread: Thread
+    private var isStopped = false
+
+    init() {
+        thread = Thread {
+            let port = Port()
+            RunLoop.current.add(port, forMode: .default)
+            CFRunLoopRun()
+            port.invalidate()
+        }
+        thread.start()
+    }
+
+    func enqueue(_ body: @Sendable @escaping () -> Void) -> RunLoopJob {
+        thread.runInLoopAsync(job: RunLoopJob(.cancellable, trackCompletion: true)) { _ in body() }
+    }
+
+    func stop() {
+        if isStopped { return }
+        isStopped = true
+        thread.runInLoopAsync(job: RunLoopJob(.nonCancellable)) { _ in CFRunLoopStop(CFRunLoopGetCurrent()) }
+    }
+}

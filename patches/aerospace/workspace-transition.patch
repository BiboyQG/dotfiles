@@ -0,0 +1,39 @@
+import Common
+
+/// An awaited layout can be superseded while the main actor runs another session.
+@MainActor
+final class LayoutGeneration {
+    fileprivate var current: UniqueToken? = nil
+
+    func begin(isValid: @escaping @MainActor () -> Bool = { true }) -> LayoutPass {
+        let token = UniqueToken()
+        current = token
+        return LayoutPass(generation: self, token: token, isValid: isValid)
+    }
+}
+
+@MainActor
+struct LayoutPass {
+    fileprivate let generation: LayoutGeneration
+    fileprivate let token: UniqueToken
+    fileprivate let isValid: @MainActor () -> Bool
+
+    var isCurrent: Bool { generation.current == token && isValid() }
+
+    @discardableResult
+    func afterRestoring(
+        _ jobs: [RunLoopJob],
+        _ body: @MainActor () async throws -> Void,
+    ) async throws -> Bool {
+        try await withThrowingTaskGroup(of: Void.self) { group in
+            for job in jobs {
+                group.addTask { try await job.awaitCompletion() }
+            }
+            try await group.waitForAll()
+        }
+        try checkCancellation()
+        guard isCurrent else { return false }
+        try await body()
+        return isCurrent
+    }
+}
